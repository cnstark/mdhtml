{
  "name": "mdhtml",
  "displayName": "mdhtml",
  "description": "在 VSCode 中预览 Markdown 并管理批注",
  "version": "1.0.0",
  "publisher": "mdhtml-local",
  "engines": {"vscode": "^1.85.0"},
  "activationEvents": ["onCommand:mdhtml.openPreview", "onLanguage:markdown"],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "mdhtml.openPreview",
      "title": "mdhtml 预览",
      "icon": "$(open-preview)"
    }],
    "menus": {
      "editor/title": [{
        "command": "mdhtml.openPreview",
        "when": "resourceExtname == .md",
        "group": "navigation"
      }]
    }
  }
}
