{
  "name": "mdhtml",
  "displayName": "mdhtml",
  "description": "在 VSCode 中以 mdhtml 查看、编辑 Markdown 和批注",
  "version": "1.0.0",
  "publisher": "mdhtml-local",
  "engines": {"vscode": "^1.85.0"},
  "activationEvents": ["onCustomEditor:mdhtml.editor", "onCommand:mdhtml.openPreview", "onCommand:mdhtml.exportHtml"],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [{
      "viewType": "mdhtml.editor",
      "displayName": "mdhtml",
      "selector": [{"filenamePattern": "*.md"}],
      "priority": "default"
    }],
    "commands": [{
      "command": "mdhtml.openPreview",
      "title": "用 mdhtml 打开",
      "icon": "$(open-preview)"
    }, {
      "command": "mdhtml.exportHtml",
      "title": "导出 .md.html",
      "icon": "$(export)"
    }],
    "menus": {
      "editor/title": [{
        "command": "mdhtml.openPreview",
        "when": "resourceExtname == .md",
        "group": "navigation"
      }, {
        "command": "mdhtml.exportHtml",
        "when": "resourceExtname == .md",
        "group": "navigation"
      }]
    }
  }
}
